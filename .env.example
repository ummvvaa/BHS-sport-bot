BOT_TOKEN=            # токен от @BotFather
SPREADSHEET_ID=       # ID из URL таблицы: docs.google.com/spreadsheets/d/<ЭТО>/edit
ADMIN_IDS=            # tg_id админов через запятую, узнать у @userinfobot
GOOGLE_CREDENTIALS_PATH=credentials.json

# Для деплоя без файла (Railway и т.п.): содержимое credentials.json одной строкой.
# Если задана — GOOGLE_CREDENTIALS_PATH игнорируется.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com",...}
